msgstr "Mantieni finestra attiva"

#: prefs.js
msgid "Do not hide the active window on toggle."
msgstr "Non nascondere la finestra attiva durante l'attivazione."

#: prefs.js
msgid "Aspect"
msgstr "Aspetto"

#: prefs.js
msgid "Position on panel"
msgstr "Posizione nel pannello"

#: prefs.js
msgid "Where to place the toggle on the panel."
msgstr "Dove posizionare il pulsante nel pannello."

#: prefs.js
msgid "Extreme Left"
msgstr "Estrema sinistra"

#: prefs.js
msgid "Left"
msgstr "Sinistra"

#: prefs.js
msgid "Center"
msgstr "Centro"

#: prefs.js
msgid "Right"
msgstr "Destra"

#: prefs.js
msgid "Extreme Right"
msgstr "Estrema destra"

#: prefs.js
msgid "Toggle icon (.svg)"
msgstr "Icona del pulsante (.svg)"

#: prefs.js
msgid "Icon file used for the panel toggle."
msgstr "File icona usato per il pulsante del pannello."

#: prefs.js
msgid "Click to change icon"
msgstr "Clic per cambiare l'icona"

#: prefs.js
msgid "Choose an icon"
msgstr "Scegli un'icona"

#: prefs.js
msgid "Images (SVG)"
msgstr "Immagini (SVG)"

