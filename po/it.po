msgid "Toggle windows with your keyboard instead of a click."
msgstr "Attiva/disattiva le finestre con la tastiera invece di un clic."

#: prefs.js
msgid "New shortcut…"
msgstr "Nuova scorciatoia…"

#: prefs.js
msgid "Set"
msgstr "Imposta"

#: prefs.js
