#: prefs.js
msgid "Right"
msgstr "Rechts"

#: prefs.js
msgid "Extreme Right"
msgstr "Uiterst rechts"

#: prefs.js
msgid "Toggle icon (.svg)"
msgstr "Knoppictogram (.svg)"

#: prefs.js
msgid "Icon file used for the panel toggle."
msgstr "Pictogrambestand voor de paneelknop."

#: prefs.js
msgid "Click to change icon"
msgstr "Klik om pictogram te wijzigen"

#: prefs.js
msgid "Choose an icon"
msgstr "Kies een pictogram"

#: prefs.js
msgid "Images (SVG)"
msgstr "Afbeeldingen (SVG)"

