<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.aero-peek-for-gnome"
        path="/org/gnome/shell/extensions/aero-peek-for-gnome/">
        <key name="keep-active-window" type="b">
            <default>false</default>
            <summary>Keep active window</summary>
            <description>Do not hide the active window on toggle.</description>
        </key>
        <key name="position-in-panel" type="s">
            <default>'extreme-left'</default>
            <summary>Position on panel</summary>
            <description>Where to place the toggle on the panel.</description>
        </key>
        <key name="toggle-icon" type="s">
            <default>'computer-symbolic'</default>
            <summary>Toggle Icon (.svg)</summary>
            <description>Icon file used for the panel toggle.</description>
        </key>
        <key name="peek-on-hover" type="b">
            <default>true</default>
            <summary>Peek on hover</summary>
            <description>Make windows transparent when hovering the button,</description>
        </key>
        <key name="peek-duration" type="i">
            <default>200</default>
            <summary>Peek duration (ms)</summary>
            <description>Animation duration for transparency effect.</description>
        </key>
        <key name="peek-delay" type="i">
            <default>0</default>
            <summary>Peek delay (ms)</summary>
            <description>Delay before making windows transparent.</description>
        </key>
        <key name="peek-opacity" type="i">
            <default>50</default>
            <summary>Window opacity (%)</summary>
            <description>Opacity percentage during peek (0-100)</description>
        </key>
        <key name="toggle-shortcut" type="as">
            <default>['&lt;Ctrl&gt;&lt;Super&gt;m']</default>
            <summary>Toggle windows</summary>
            <description>Toggle windows with your keyboard instead of a click.</description>
        </key>
    </schema>
</schemalist>
